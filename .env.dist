# Copy to .env (gitignored). Local development only.
CHAMILO_VERSION=v3.0.2
CHAMILO_PORT=8080
CHAMILO_ADMIN_PASSWORD=admin

# eXeLearning editor source used by `make build-editor` (same variables as the siblings).
EXELEARNING_EDITOR_REPO_URL=https://github.com/exelearning/exelearning.git
EXELEARNING_EDITOR_DEFAULT_BRANCH=main
EXELEARNING_EDITOR_REF=
EXELEARNING_EDITOR_REF_TYPE=auto
